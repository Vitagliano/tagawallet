# Required
MONGODB_URI=mongodb://127.0.0.1:27017/tagawallet
APP_URL=http://localhost:3000

# Comma-separated emails that can use the moderation queue at /admin/reports
ADMIN_EMAILS=

# Transactional email. Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=TagAWallet <hello@tagawallet.com>

# OAuth. A provider's button appears only when its keys are set.
# Callback URLs: {APP_URL}/api/auth/oauth/google/callback and /x/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Used to read ENS text records during verification. Defaults to a public endpoint.
ETH_RPC_URL=

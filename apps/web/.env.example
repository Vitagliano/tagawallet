# Required
MONGODB_URI=mongodb://127.0.0.1:27017/tagawallet
APP_URL=http://localhost:3000

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must match the public site origin people use (include www if that's the live host).
# On Vercel production set both APP_URL and BETTER_AUTH_URL to https://www.tagawallet.com
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that can use /admin (moderation and extension sites).
# An address only counts once its owner has confirmed it.
ADMIN_EMAILS=

# Transactional email via Resend. Without a key, emails are printed to the server log.
# Verify the from-domain in Resend before production sends will deliver.
RESEND_API_KEY=
EMAIL_FROM=TagAWallet <donotreply@tagawallet.com>

# OAuth. A provider's button appears only when its keys are set.
# Callback URLs: {APP_URL}/api/auth/oauth/google/callback and /x/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Ethereum mainnet RPC. Verification reads ENS text records through it (a public endpoint if unset).
# When set, .eth names seen by the extension are also resolved to addresses, cached for a day.
ETH_RPC_URL=

# Chrome Web Store listing. Every "Add to Chrome" button points here; unset, they go to /extension.
NEXT_PUBLIC_EXTENSION_STORE_URL=
